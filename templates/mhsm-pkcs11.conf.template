{
    "ManagedHsm": {
        "VaultUri": "https://YOUR_HSM_NAME.managedhsm.azure.net/",
        "TenantId": "YOUR_TENANT_ID",
        "Authentication": {
            "Method": "ServicePrincipal",
            "ClientId": "YOUR_CLIENT_ID",
            "ClientSecret": "YOUR_CLIENT_SECRET"
        }
    },
    "ConnectionCache": {
        "Disable": false,
        "MaxConnections": 20
    },
    "Logging": {
        "Level": "Info",
        "FilePath": "/var/log/mhsm-pkcs11.log"
    },
    "Security": {
        "KeyTimeout": 300,
        "SessionTimeout": 3600
    }
}